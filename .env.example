# Copy to .env and fill in. .env is git-ignored - never commit real values.
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true

# Database (docker-compose sets this for you; set it yourself for other hosts)
DATABASE_URL=postgresql+psycopg://nse:nse@localhost:5432/nse
POSTGRES_PASSWORD=change-me
# Connection pool, PER PROCESS and shared by request handlers, the scheduler thread and the bootstrap
# thread. Managed Postgres plans cap *total* connections low (Render's smallest allows roughly 22 across all
# clients and replicas), so keep POOL_SIZE + MAX_OVERFLOW well under that budget, multiplied by the number
# of processes you run. An over-sized pool is what exhausts the server and gets connections terminated.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300                 # recycle before the host drops an idle connection
DB_CONNECT_TIMEOUT=10               # so a DNS or routing failure cannot block a thread indefinitely
# Bounded exponential retry for transient connectivity failures (DNS, TLS teardown, dropped connections).
# Query, data and integrity errors are never retried.
DB_RETRY_ATTEMPTS=4
DB_RETRY_BASE_SECONDS=0.5
DB_RETRY_MAX_SECONDS=15
# Background jobs and the first-run load wait this long for the database before giving up. The API binds its
# port and serves /health/live regardless, so a slow database never fails the deploy.
DB_READY_TIMEOUT_SECONDS=300
DB_GATE_RECHECK_SECONDS=30          # how often a job re-probes while the database is down
# Optional cache (the app works without Redis)
REDIS_URL=

# Security - REQUIRED in production
SESSION_SECRET=generate-with: python -c "import secrets;print(secrets.token_urlsafe(48))"
COOKIE_SECURE=false                 # must be true in production (HTTPS)
CORS_ORIGINS=["http://localhost:3000"]
ALLOW_REGISTRATION=true             # set false after creating your account

# Market data - MyStocks Africa Partner API (15-minute delayed NSE data)
MYSTOCKS_API_KEY=
MYSTOCKS_ENV=sandbox                # sandbox | production

# Run the scheduled jobs (quotes, end-of-day analytics, alerts, backtests) inside the API process instead of
# a separate `nse-worker`. For hosts without a background worker (e.g. Render free/Starter web service only).
# The API instance must stay awake, or jobs stop running. Prefer a separate worker when the host allows one.
RUN_SCHEDULER_IN_API=false

# Keep a free-tier instance awake: the app requests its own /health/live on this interval. That endpoint
# returns a static response and touches neither the database nor Redis. Must be the PUBLIC url - a
# loopback request never reaches the host's router. On Render, RENDER_EXTERNAL_URL is used automatically,
# so leave this empty there. Empty = disabled.
SELF_PING_URL=
SELF_PING_MINUTES=10

# First-run data load (instruments, history, corporate actions, analytics). On by default, and needs no
# other setting: it does nothing unless a provider key is set AND no real price bars exist yet, so redeploys
# do not reload. It runs on its own background thread, NOT in the container command - a host that waits for
# the port to be bound fails the deploy if a multi-year backfill runs first. Set false to load data yourself.
BOOTSTRAP_ON_START=true
BOOTSTRAP_BACKFILL_YEARS=3
# The load waits for database connectivity, then retries if it reports itself incomplete. It is the only
# thing that fills a fresh database, so a single start-up failure must not leave the deployment empty.
BOOTSTRAP_MAX_ATTEMPTS=5
BOOTSTRAP_RETRY_MAX_SECONDS=300

# Development only - never enabled when APP_ENV=production
ENABLE_SYNTHETIC_PROVIDER=true
