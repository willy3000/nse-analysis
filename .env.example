# Copy to .env and fill in. .env is git-ignored - never commit real values.
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true

# Database (docker-compose sets this for you; set it yourself for other hosts)
DATABASE_URL=postgresql+psycopg://nse:nse@localhost:5432/nse
POSTGRES_PASSWORD=change-me
# Optional cache (the app works without Redis)
REDIS_URL=

# Security - REQUIRED in production
SESSION_SECRET=generate-with: python -c "import secrets;print(secrets.token_urlsafe(48))"
COOKIE_SECURE=false                 # must be true in production (HTTPS)
CORS_ORIGINS=["http://localhost:3000"]
ALLOW_REGISTRATION=true             # set false after creating your account

# Market data - MyStocks Africa Partner API (15-minute delayed NSE data)
MYSTOCKS_API_KEY=
MYSTOCKS_ENV=sandbox                # sandbox | production

# Run the scheduled jobs (quotes, end-of-day analytics, alerts, backtests) inside the API process instead of
# a separate `nse-worker`. For hosts without a background worker (e.g. Render free/Starter web service only).
# The API instance must stay awake, or jobs stop running. Prefer a separate worker when the host allows one.
RUN_SCHEDULER_IN_API=false

# Keep a free-tier instance awake: the app requests its own /health/live on this interval. That endpoint
# returns a static response and touches neither the database nor Redis. Must be the PUBLIC url - a
# loopback request never reaches the host's router. On Render, RENDER_EXTERNAL_URL is used automatically,
# so leave this empty there. Empty = disabled.
SELF_PING_URL=
SELF_PING_MINUTES=10

# First-run data load (instruments, history, corporate actions, analytics). It runs on the scheduler thread
# about 30s after start-up, NOT in the container command: a host that waits for the port to be bound fails
# the deploy if a multi-year backfill runs first. Needs RUN_SCHEDULER_IN_API=true (or a worker) to have
# somewhere to run. It skips itself once real price bars exist, so redeploys do not repeat it.
BOOTSTRAP_ON_START=false
BOOTSTRAP_BACKFILL_YEARS=3

# Development only - never enabled when APP_ENV=production
ENABLE_SYNTHETIC_PROVIDER=true
