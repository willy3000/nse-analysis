{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infrastructure/docker/api.Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "python -m nse_platform.worker.main",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
